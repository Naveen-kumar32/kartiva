# /etc/systemd/system/gunicorn.service — Django app server (template, Phase 9)
[Unit]
Description=Kartiva Django (Gunicorn)
Requires=gunicorn.socket
After=network.target postgresql.service

[Service]
Type=notify
User=marketplace
Group=www-data
WorkingDirectory=/var/www/kartiva/backend
EnvironmentFile=/etc/kartiva/backend.env
ExecStart=/var/www/kartiva/backend/.venv/bin/gunicorn config.wsgi:application \
  --workers 3 --threads 2 --timeout 30 --graceful-timeout 25 --max-requests 1000 --max-requests-jitter 100 \
  --access-logfile - --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
# Graceful shutdown: finish in-flight requests on deploy/restart
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=3
# Least privilege / hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/kartiva/backend/media /run

[Install]
WantedBy=multi-user.target
