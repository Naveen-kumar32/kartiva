{
  "name": "kartiva-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src && node scripts/check-locale-order.mjs",
    "lint:locales": "node scripts/check-locale-order.mjs",
    "generate:mock": "python3 -I scripts/generate-mock-data.py",
    "e2e": "node e2e/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:size": "node scripts/check-bundle-size.mjs",
    "dev:api": "VITE_DATA_MODE=api VITE_API_URL=/api/v1 vite"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "axios": "^1.21.1",
    "formik": "^2.4.9",
    "framer-motion": "^14.12.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "react-toastify": "^11.2.0",
    "write-excel-file": "^4.1.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
